{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/camera.schema.json",
  "title": "Camera Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "camera_pack_id",
    "cameras",
    "live_director"
  ],
  "properties": {
    "camera_pack_id": {
      "type": "string",
      "minLength": 1
    },
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/camera"
      }
    },
    "live_director": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "switchable_camera_ids"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "switchable_camera_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "z"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "z": {
          "type": "number"
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "camera_id",
        "type",
        "position",
        "rotation",
        "fov"
      ],
      "properties": {
        "camera_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "wide",
            "medium",
            "close_up",
            "top_down",
            "custom"
          ]
        },
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "rotation": {
          "$ref": "#/$defs/vector3"
        },
        "fov": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "target_character_id": {
          "type": "string"
        }
      }
    }
  }
}
