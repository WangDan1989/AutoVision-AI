{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/project.schema.json",
  "title": "AI Generated Shortfilm Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project_id",
    "name",
    "version",
    "engine",
    "asset_pipeline",
    "runtime_asset_locks",
    "personas",
    "scripts",
    "cameras",
    "backend",
    "audio",
    "render"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "godot"
        },
        "version": {
          "type": "string",
          "pattern": "^4(\\.\\d+){0,2}$"
        }
      }
    },
    "asset_pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "default_backend",
        "backends",
        "postprocess",
        "publishing"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "default_backend": {
          "type": "string",
          "minLength": 1
        },
        "backends": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assetGenBackend"
          }
        },
        "postprocess": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "normalize_scale",
            "normalize_material",
            "auto_rig_or_retarget",
            "default_rig_profile_id"
          ],
          "properties": {
            "normalize_scale": {
              "type": "boolean"
            },
            "normalize_material": {
              "type": "boolean"
            },
            "auto_rig_or_retarget": {
              "type": "boolean"
            },
            "default_rig_profile_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "publishing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "require_quality_gate",
            "lock_approved_revision"
          ],
          "properties": {
            "require_quality_gate": {
              "type": "boolean"
            },
            "lock_approved_revision": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "runtime_asset_locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "scenes",
        "props",
        "actions"
      ],
      "properties": {
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeAssetRef"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeAssetRef"
          }
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/runtimeAssetRef"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/actionRef"
          }
        }
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "scripts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "cameras": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileRef"
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_backend",
        "strata",
        "ollama",
        "queue",
        "fallback_mode"
      ],
      "properties": {
        "active_backend": {
          "type": "string",
          "enum": [
            "strata",
            "ollama"
          ]
        },
        "strata": {
          "$ref": "#/$defs/llmBackendEndpoint"
        },
        "ollama": {
          "$ref": "#/$defs/llmBackendEndpoint"
        },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_concurrency",
            "max_queue_size",
            "request_timeout_ms"
          ],
          "properties": {
            "max_concurrency": {
              "type": "integer",
              "minimum": 1
            },
            "max_queue_size": {
              "type": "integer",
              "minimum": 1
            },
            "request_timeout_ms": {
              "type": "integer",
              "minimum": 1000
            }
          }
        },
        "fallback_mode": {
          "type": "string",
          "enum": [
            "preset_only",
            "llm_with_preset_fallback"
          ]
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tts",
        "lipsync",
        "library"
      ],
      "properties": {
        "tts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "voice_id",
            "sample_rate",
            "cache_enabled"
          ],
          "properties": {
            "provider": {
              "const": "piper"
            },
            "voice_id": {
              "type": "string",
              "minLength": 1
            },
            "sample_rate": {
              "type": "integer",
              "enum": [
                16000,
                22050,
                24000
              ]
            },
            "cache_enabled": {
              "type": "boolean"
            }
          }
        },
        "lipsync": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "enabled"
          ],
          "properties": {
            "provider": {
              "const": "rhubarb"
            },
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "library": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bgm",
            "sfx",
            "ambience"
          ],
          "properties": {
            "bgm": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/audioRef"
              }
            },
            "sfx": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/audioRef"
              }
            },
            "ambience": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/audioRef"
              }
            }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "resolution",
        "fps",
        "output_format"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "script_auto",
            "live_director"
          ]
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "fps": {
          "type": "integer",
          "minimum": 1
        },
        "output_format": {
          "type": "string",
          "enum": [
            "video",
            "png_sequence",
            "exr_sequence"
          ]
        },
        "codec": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "fileRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "runtimeAssetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "revision_id",
        "path",
        "status"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "\\.(glb|gltf)$"
        },
        "status": {
          "type": "string",
          "enum": [
            "approved",
            "locked"
          ]
        }
      }
    },
    "actionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "priority"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "llmBackendEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "host",
        "port",
        "model",
        "temperature",
        "top_p",
        "max_tokens"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "assetGenBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "host",
        "port",
        "modes",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "text_to_3d",
              "image_to_3d",
              "hybrid"
            ]
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "audioRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "channel"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "enum": [
            "bgm",
            "sfx",
            "ambience"
          ]
        }
      }
    }
  }
}
